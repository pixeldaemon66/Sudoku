<Window x:Class="Sudoku.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sudoku"
        mc:Ignorable="d"
        Title="Sudoku" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Background>
            <ImageBrush Stretch="UniformToFill" TileMode="Tile" ImageSource="/bg.jpg"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <Viewbox x:Name="SudokuBoard" Margin="26,18,26,17" Grid.Column="1" Stretch="Uniform" Grid.Row="1">
            <ItemsControl x:Name="Board" Width="150" Height="150" ItemsSource="{Binding Cells}" Visibility="Hidden">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="9" Columns="9" Background="#f1ebdb" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#141013" BorderThickness="{Binding BorderThickness}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Background" Value="#e86a73" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#b3b9d1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBox Text="{Binding Text, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsFixed}"
                                     BorderBrush="Transparent"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MaxLength="1"
                                     FontSize="9"
                                     Cursor="Hand"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     PreviewTextInput="Cell_PreviewTextInput"
                                     PreviewKeyDown="Cell_PreviewKeyDown"
                                     PreviewMouseDown="Cell_PreviewMouseDown"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Viewbox>
        <Menu Grid.Row="0" Grid.ColumnSpan="2" FontFamily="Meiryo" FontSize="14">
            <Menu.Background>
                <ImageBrush ImageSource="/papertexture.jpg"/>
            </Menu.Background>
            <MenuItem Header="Гра" Cursor="Hand" Height="26" Width="52" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" Foreground="#FF654236">
                <MenuItem x:Name="NewGame_Btn" Header="Нова гра" Cursor="Hand" Click="NewGame_Btn_Click" />
                <MenuItem x:Name="GiveUp_Btn" Header="Здатися" Cursor="Hand" Click="GiveUp_Btn_Click" />
                <MenuItem x:Name="Quit_Btn" Header="Вийти" Cursor="Hand" Click="Quit_Btn_Click" />
            </MenuItem>
            <MenuItem Header="Профілі" Cursor="Hand" Height="26" Width="72" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" Background="Transparent" Foreground="#FF654236">
                <MenuItem x:Name="Player_Btn" Header="Обрати профіль" Cursor="Hand" Click="Player_Btn_Click" />
                <MenuItem x:Name="Leaderboards_Btn" Header="Рекорди" Cursor="Hand" Click="Leaderboards_Btn_Click"/>
            </MenuItem>
            <MenuItem x:Name="Manual_Btn" Header="Як грати" Cursor="Help" Click="Manual_Btn_Click" Foreground="#FF654236"/>
        </Menu>
        <Button x:Name="Reset_Btn" Content="Скинути" HorizontalAlignment="Left" Margin="30,346,0,0" Grid.Row="1" VerticalAlignment="Top" Height="26" Width="133" Cursor="Hand" Click="Reset_Btn_Click" BorderBrush="#FF654236" FontFamily="Meiryo" FontWeight="Bold" FontStyle="Italic" Foreground="#FF654236">
            <Button.Background>
                <ImageBrush ImageSource="/papertexture.jpg"/>
            </Button.Background>
        </Button>
        <Rectangle x:Name="Hint_Btn" HorizontalAlignment="Left" Height="54" Margin="220,53,0,0" Grid.Row="1" VerticalAlignment="Top" Width="42" Cursor="Hand" Focusable="True" ToolTip="Підказка" MouseDown="Hint_Click">
            <Rectangle.Fill>
                <ImageBrush ImageSource="/hint.png"/>
            </Rectangle.Fill>
        </Rectangle>
        <Label x:Name="Timer_Lbl" Content="00:00:00" HorizontalAlignment="Left" Height="35" Margin="30,125,0,0" Grid.Row="1" VerticalAlignment="Top" Width="120" FontFamily="Meiryo" FontSize="16" FontStyle="Italic" FontWeight="Bold" Foreground="#FF654236"/>
        <TextBox x:Name="Username_Txt" HorizontalAlignment="Left" Margin="30,88,0,0" Grid.Row="1" TextWrapping="Wrap" Text="Player" VerticalAlignment="Top" Width="120" Background="{x:Null}" FontFamily="Meiryo" FontSize="14" BorderBrush="{x:Null}" TextDecorations="Underline" FontWeight="Bold" Focusable="False" IsEnabled="False" SelectionBrush="{x:Null}" Foreground="Black"/>
        <TextBlock x:Name="Hints" HorizontalAlignment="Left" Margin="236,114,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="26" FontSize="16" Text="3" FontWeight="Bold" Foreground="#FF654236"/>
        <Button x:Name="HideTimer_Btn" Content="Сховати таймер" HorizontalAlignment="Left" Margin="30,165,0,0" Grid.Row="1" VerticalAlignment="Top" Height="26" Width="133" Click="HideTimer_Btn_Click" Cursor="Hand" BorderBrush="#FF654236" FontFamily="Meiryo" FontWeight="Bold" FontStyle="Italic" Foreground="#FF654236">
            <Button.Background>
                <ImageBrush ImageSource="/papertexture.jpg"/>
            </Button.Background>
        </Button>
        <Label Content="Зараз грає:" HorizontalAlignment="Left" Height="33" Margin="30,50,0,0" Grid.Row="1" VerticalAlignment="Top" Width="120" FontWeight="Bold" FontFamily="Meiryo" FontSize="16" FontStyle="Italic" Foreground="#FF654236"/>
    </Grid>
</Window>
