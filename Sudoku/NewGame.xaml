<Window x:Class="Sudoku.NewGame"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sudoku"
        mc:Ignorable="d"
        Title="Рівень складності" Height="302" Width="486" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/bg2.jpg"/>
        </Grid.Background>
        <GroupBox HorizontalAlignment="Center" Height="206" Margin="0,20,0,0" VerticalAlignment="Top" Width="292" BorderBrush="#FF654236" FontFamily="Meiryo" FontSize="14">
            <GroupBox.Background>
                <ImageBrush ImageSource="/papertexture.jpg" Opacity="0.42"/>
            </GroupBox.Background>
            <Grid>
                <Grid.Background>
                    <ImageBrush Opacity="1"/>
                </Grid.Background>
                <RadioButton x:Name="Easy" GroupName="Difficulty" Content="Легкий" HorizontalAlignment="Left" Margin="88,31,0,0" VerticalAlignment="Top" IsChecked="True" Cursor="Hand" FontFamily="Meiryo" FontWeight="Bold" FontStyle="Italic" Foreground="#FF654236"/>
                <RadioButton x:Name="Medium" GroupName="Difficulty" Content="Середній" HorizontalAlignment="Left" Margin="88,51,0,0" VerticalAlignment="Top" Cursor="Hand" FontFamily="Meiryo" FontWeight="Bold" FontStyle="Italic" Foreground="#FF654236"/>
                <RadioButton x:Name="Hard" GroupName="Difficulty" Content="Складний" HorizontalAlignment="Left" Margin="88,71,0,0" VerticalAlignment="Top" Cursor="Hand" FontFamily="Meiryo" FontWeight="Bold" FontStyle="Italic" Foreground="#FF654236"/>
                <RadioButton x:Name="Expert" GroupName="Difficulty" Content="Експертний" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand" Margin="88,91,0,0" FontFamily="Meiryo" FontWeight="Bold" FontStyle="Italic" Foreground="#FF654236"/>
                <Button x:Name="Start_Btn" Content="Нова гра" HorizontalAlignment="Center" Margin="0,128,0,0" VerticalAlignment="Top" Width="104" Cursor="Hand" Click="Start_Bth_Click" FontWeight="Bold" FontStyle="Italic" Foreground="#FF654236">
                    <Button.Background>
                        <ImageBrush ImageSource="/papertexture.jpg"/>
                    </Button.Background>
                </Button>
            </Grid>
        </GroupBox>

    </Grid>
</Window>
